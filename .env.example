# Public browser credential from Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Use the same Google OAuth client ID on the server for ID-token verification.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Neon PostgreSQL connection string. Never commit the real value.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: openssl rand -hex 32
# This signs secure session cookies. Never expose or commit the real value.
SESSION_SECRET=replace-with-at-least-32-random-characters
