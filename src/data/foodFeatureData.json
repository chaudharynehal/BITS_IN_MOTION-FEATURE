    "sources": [
      {
        "id": "nutrilens",
        "name": "NutriLens IndianFoodDB-30 nutrition table",
        "url": "https://github.com/bhatt-aditya03/NutriLens",
        "licence": "MIT",
        "note": "Calories and protein per 100 g are reproduced from the project README. The project states that its values were averaged from IFCT 2017 and USDA FoodData Central."
      },
      {
        "id": "prototype",
        "name": "BITS in Motion prototype estimate",
        "url": "",
        "licence": "Project data",
        "note": "A deliberately broad fallback for a detector category. Replace with a verified recipe or food-composition record before health or research use."
      }
    ],
    "thresholds": {
      "minimumConfidence": 0.4,
      "maximumDetections": 12,
      "nmsIouThreshold": 0.45,
      "minimumServingGrams": 5,
      "maximumServingGrams": 1500
    },
    "inputContract": {
      "description": "The local model returns one object per detected food region.",
      "fields": {
        "classIndex": "Integer from 0 to 13 matching labels[index].",
        "confidence": "Number from 0 to 1.",
        "boundingBox": "{ x, y, width, height } in image pixels."
      }
    },
    "requiredFlow": [
      "Process the photo locally on the device.",
      "Remove predictions below minimumConfidence.",
      "Suppress overlapping predictions of the same class at nmsIouThreshold.",
      "Show the suggested food and alternatives to the user.",
      "Require the user to confirm the food and serving grams.",
      "Calculate calories and protein from the confirmed food record.",
      "Save only numerical results; never save the photo."
    ],
    "nutritionFormula": {
      "calories": "caloriesPer100g * servingGrams / 100",
      "proteinGrams": "proteinPer100g * servingGrams / 100",
      "calorieRangeLow": "calories * (1 - uncertainty)",
      "calorieRangeHigh": "calories * (1 + uncertainty)"
    },
    "disclaimer": "Food recognition and nutrition values are estimates. Confirm the dish and serving size; recipes, oil and portions can change the result substantially. This is general guidance, not medical or dietary treatment."
  },
